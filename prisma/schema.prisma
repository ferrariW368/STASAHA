generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String  @id @default(cuid())
  username     String  @unique
  passwordHash String
  staBalance   Int     @default(1000)
  role         String  @default("user") // "user" | "admin"
  createdAt    DateTime @default(now())
  bets         Bet[]
  lineups      Lineup[]
}

model Team {
  id      String   @id @default(cuid())
  name    String
  players Player[]
  homeMatches Match[] @relation("HomeTeam")
  awayMatches Match[] @relation("AwayTeam")
  transfersFrom TransferNews[] @relation("TransferFrom")
  transfersTo   TransferNews[] @relation("TransferTo")
}

model Player {
  id      String  @id @default(cuid())
  teamId  String? // null = free agent / unattached, so players can be transferred between teams
  team    Team?   @relation(fields: [teamId], references: [id])
  name    String
  number  Int?
  position String? // "GK" | "DEF" | "MID" | "FWD" — used to place the player on the lineup-builder pitch
  playerGoals PlayerGoal[]
  playerEvents PlayerEvent[]
  transferNews TransferNews[]
  lineupSlots LineupSlot[]

  // Mackolik/Transfermarkt-style profile — all fields below are admin-entered
  // flavor stats (inspired by a real footballer's playing style), never
  // scraped or copied from any real database, and never include real
  // biographical facts (birthplace, real career, real clubs).
  styleInspiration String? // e.g. "Lionel Messi" — just a fun label
  pace             Int?    // 1-99, FIFA-card style attribute
  shooting         Int?
  passing          Int?
  dribbling        Int?
  defending        Int?
  physical         Int?
  marketValue      Int?    // fictional value in STA, not real money
}

model Match {
  id             String   @id @default(cuid())
  homeTeamId     String
  awayTeamId     String
  homeTeam       Team     @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam       Team     @relation("AwayTeam", fields: [awayTeamId], references: [id])
  kickoffTime    DateTime
  status         String   @default("upcoming") // "upcoming" | "locked" | "finished" | "cancelled"
  finalHomeScore Int?
  finalAwayScore Int?
  redCard        Boolean?
  pitchInvasion  Boolean?
  refereeArgument Boolean?
  matchAbandoned  Boolean?
  odds           Odds[]
  bets           Bet[]
  playerGoals    PlayerGoal[]
  playerEvents   PlayerEvent[]
}

model PlayerGoal {
  id        String @id @default(cuid())
  matchId   String
  match     Match  @relation(fields: [matchId], references: [id])
  playerId  String
  player    Player @relation(fields: [playerId], references: [id])
  goalCount Int

  @@unique([matchId, playerId])
}

model PlayerEvent {
  id        String  @id @default(cuid())
  matchId   String
  match     Match   @relation(fields: [matchId], references: [id])
  playerId  String
  player    Player  @relation(fields: [playerId], references: [id])
  eventType String  // "FIGHT" | "LATE"
  happened  Boolean

  @@unique([matchId, playerId, eventType])
}

model Odds {
  id            String @id @default(cuid())
  matchId       String
  match         Match  @relation(fields: [matchId], references: [id])
  market        String // "1X2" | "SCORE" | "OU_GOALS" | "PLAYER_GOALS" | "BTS" | "NOVELTY" | "FIGHT" | "LATE"
  selectionKey  String // e.g. "1", "2-1", "OVER_4.5", "<playerId>:2+"
  oddsValue     Float

  @@unique([matchId, market, selectionKey])
}

model Bet {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  matchId       String
  match         Match    @relation(fields: [matchId], references: [id])
  stake         Int
  totalOdds     Float
  potentialWin  Int
  status        String   @default("pending") // "pending" | "won" | "lost" | "refunded"
  createdAt     DateTime @default(now())
  selections    BetSelection[]

  @@unique([userId, matchId])
}

model BetSelection {
  id             String @id @default(cuid())
  betId          String
  bet            Bet    @relation(fields: [betId], references: [id])
  market         String
  selectionKey   String
  oddsValueAtBet Float
}

model TransferNews {
  id         String   @id @default(cuid())
  playerId   String
  player     Player   @relation(fields: [playerId], references: [id])
  fromTeamId String?
  fromTeam   Team?    @relation("TransferFrom", fields: [fromTeamId], references: [id])
  toTeamId   String?
  toTeam     Team?    @relation("TransferTo", fields: [toTeamId], references: [id])
  stage      String   // "RUMOR" | "ADVANCED" | "FAILED" | "SIGNED"
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// A user-submitted fantasy-style squad + pitch formation, pending admin
// approval. Approving one creates a real Team and transfers the selected
// players onto it, so it's ready to pick when admin sets up the next match.
model Lineup {
  id            String   @id @default(cuid())
  squadName     String
  format        Int      // players per side including GK: 5, 6, 7, or 8
  submittedById String
  submittedBy   User     @relation(fields: [submittedById], references: [id])
  status        String   @default("pending") // "pending" | "approved" | "rejected"
  createdAt     DateTime @default(now())
  slots         LineupSlot[]
}

model LineupSlot {
  id        String @id @default(cuid())
  lineupId  String
  lineup    Lineup @relation(fields: [lineupId], references: [id])
  playerId  String
  player    Player @relation(fields: [playerId], references: [id])
  position  String // "GK" | "DEF" | "MID" | "FWD"
  slotOrder Int    // left-to-right order within that position row, for layout

  @@unique([lineupId, playerId])
}
